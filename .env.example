# ---------------------------------------------------------------------------
# LiveKit Cloud credentials (free Build plan - no payment method required).
# Copy this file to .env and fill in the values from https://cloud.livekit.io
# The real .env file is git-ignored - never commit it.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# All optional. Defaults live in agent.py / prompts.py.
# ---------------------------------------------------------------------------

# LiveKit Inference model IDs (change only if a model is retired).
# STT_MODEL=deepgram/nova-3
# STT_FALLBACK_MODEL=deepgram/flux-general
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# TTS_MODEL=cartesia/sonic-3
# TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# TTS_FALLBACK_MODEL=deepgram/aura-2

# Error handling / logs.
# USER_AWAY_TIMEOUT=12
# MAX_AWAY_PROMPTS=3
# LOG_LEVEL=INFO

# Override the system prompt defined in prompts.py.
# AGENT_SYSTEM_PROMPT=""
